pkgname=omasports
pkgver=1.0.0
pkgrel=1
pkgdesc='Live scores and fixtures for every sport'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omasports "$pkgdir/usr/bin/omasports"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omasports.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasports.svg"
  install -Dm644 "$startdir/omasports.desktop" "$pkgdir/usr/share/applications/omasports.desktop"
}
